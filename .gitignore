__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Site-specific values (GCP project, paths, hostnames, auth keys) — resolved at
# cluster-config load time, never committed.
.env

# mace CLI credentials (see `mace init --env-file`), never committed.
.env.mace

# Loop run artifacts: caches, metrics DBs, logs, collected simulation output.
runs/
*.db

# LaTeX build junk -- only paper/*.tex and paper/*.pdf are committed.
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc

# Created by flake.nix's own shellHook on first `nix develop` -- a local,
# machine-specific virtualenv, never committed.
.venv/
