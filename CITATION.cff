    family-names: Mumtaz
  - given-names: Muhammad
    family-names: Imran
version: 0.0.1
license: BSD-3-Clause
repository-code: "https://github.com/ranaumarnadeem/MACE"
url: "https://ranaumarnadeem.github.io/MACE/"
keywords:
  - OpenPiton
  - CHIA
  - multicore
  - LLM agents
  - agentic AI
  - hardware design automation
  - RISC-V
  - network on chip
  - Verilator
